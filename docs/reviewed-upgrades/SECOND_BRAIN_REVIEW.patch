+import json
+import os
+from pathlib import Path
+import tempfile
+import unittest
+
+from core.second_brain import SecondBrain, SyntheticVault, recovery_export, recovery_import, DAY
+
+
+class SecondBrainTests(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.path = Path(self.tmp.name) / 'synthetic.db'
+        self.key = os.urandom(32)
+        self.vault = SyntheticVault()
+        self.now = 100 * DAY
+        self.brain = SecondBrain(self.path, self.key, self.vault, lambda: self.now)
+
+    def tearDown(self):
+        self.brain.close()
+        self.tmp.cleanup()
+
+    def add(self, identity='r1', text='synthetic dashboard plan', age=0, **kwargs):
+        self.brain.set_capture_consent(True)
+        return self.brain.capture(identity, 'synthetic-session', 'user', text,
+                                  created=self.now-age*DAY, **kwargs)
+
+    def recovery(self):
+        envelope = recovery_export(self.key, 'synthetic recovery phrase only')
+        self.brain.verify_recovery(envelope, 'synthetic recovery phrase only')
+        return envelope
+
+    def test_opt_in_required(self):
+        with self.assertRaises(PermissionError):
+            self.brain.capture('r1', 's', 'user', 'not captured')
+
+    def test_database_and_archive_are_encrypted(self):
+        self.add(text='unique synthetic confidential content')
+        self.brain.sync()
+        self.assertNotIn(b'unique synthetic confidential content', self.path.read_bytes())
+        self.assertNotIn(b'confidential', self.vault.objects['r1'])
+
+    def test_redacts_common_secrets(self):
+        self.add(text='password="two words" token=demo-secret Bearer abc.def.ghi sk-abcdefghijklmnop')
+        text = self.brain.retrieve('r1')['record']['text']
+        for secret in ['two words', 'demo-secret', 'abc.def.ghi', 'sk-abcdefghijklmnop']:
+            self.assertNotIn(secret, text)
+
+    def test_sessions_order_and_provenance(self):
+        self.add(age=2, kind='confirmed_decision')
+        self.brain.capture('r2', 'other-session', 'assistant', 'dashboard summary', kind='summary')
+        rows = self.brain.search('dashboard')
+        self.assertEqual([r['id'] for r in rows], ['r2', 'r1'])
+        self.assertEqual(rows[0]['record']['kind'], 'summary')
+        self.assertEqual(rows[1]['record']['kind'], 'confirmed_decision')
+
+    def test_duplicate_capture_is_idempotent(self):
+        self.add()
+        self.add()
+        self.assertEqual(self.brain.health()['active'], 1)
+        with self.assertRaises(ValueError):
+            self.add(text='changed content')
+
+    def test_duplicate_sync_is_idempotent(self):
+        self.add()
+        self.assertEqual(self.brain.sync()['verified'], 1)
+        self.assertEqual(self.brain.sync()['verified'], 0)
+        self.assertEqual(len(self.vault.objects), 1)
+
+    def test_offline_preserves_queue(self):
+        self.add()
+        self.vault.online = False
+        self.assertEqual(self.brain.sync()['failed'], 1)
+        self.assertEqual(self.brain.health()['states']['pending'], 1)
+        self.assertTrue(self.brain.retrieve('r1'))
+
+    def test_quota_exhaustion_preserves_local(self):
+        self.add()
+        self.vault.quota = 1
+        self.assertEqual(self.brain.sync()['failed'], 1)
+        self.assertEqual(self.brain.health()['active'], 1)
+
+    def test_interrupted_upload_recovers_without_duplicate(self):
+        self.add()
+        original = self.vault.put_if_absent
+        def interrupted(identity, payload):
+            original(identity, payload)
+            raise KeyboardInterrupt()
+        self.vault.put_if_absent = interrupted
+        with self.assertRaises(KeyboardInterrupt):
+            self.brain.sync()
+        self.vault.put_if_absent = original
+        self.assertEqual(self.brain.sync()['verified'], 1)
+        self.assertEqual(len(self.vault.objects), 1)
+
+    def test_corrupt_archive_not_verified(self):
+        self.add()
+        self.vault.objects['r1'] = b'bad'
+        self.assertEqual(self.brain.sync()['failed'], 1)
+
+    def test_restart_preserves_queue_not_consent(self):
+        self.add()
+        self.brain.close()
+        self.brain = SecondBrain(self.path, self.key, self.vault, lambda: self.now)
+        self.assertFalse(self.brain.capture_enabled)
+        self.assertEqual(self.brain.sync()['verified'], 1)
+
+    def test_recovery_round_trip_and_wrong_passphrase(self):
+        envelope = self.recovery()
+        self.assertEqual(recovery_import(envelope, 'synthetic recovery phrase only'), self.key)
+        with self.assertRaises(Exception):
+            recovery_import(envelope, 'wrong recovery phrase')
+
+    def test_retention_requires_approval_and_recovery(self):
+        self.add(age=31)
+        self.brain.sync()
+        with self.assertRaises(PermissionError):
+            self.brain.expire_active(approved=True)
+        self.recovery()
+        with self.assertRaises(PermissionError):
+            self.brain.expire_active()
+
+    def test_rolling_boundary_archive_restoration(self):
+        self.add(age=31)
+        self.add('boundary', age=30)
+        self.brain.sync()
+        self.recovery()
+        self.assertEqual(self.brain.expire_active(approved=True)['expired'], 1)
+        self.assertEqual(self.brain.health()['active'], 1)
+        self.assertEqual(self.brain.search('dashboard')[0]['id'], 'boundary')
+        self.assertEqual(self.brain.retrieve('r1')['record']['text'], 'synthetic dashboard plan')
+
+    def test_retention_outage_preserves_only_copy(self):
+        self.add(age=31)
+        self.brain.sync()
+        self.recovery()
+        self.vault.online = False
+        self.assertEqual(self.brain.expire_active(approved=True)['preserved'], 1)
+        self.assertEqual(self.brain.health()['active'], 1)
+
+    def test_explicit_restore_rebuilds_local_search(self):
+        self.add(age=31)
+        self.brain.sync()
+        self.recovery()
+        self.brain.expire_active(approved=True)
+        self.assertEqual(self.brain.search('dashboard'), [])
+        with self.assertRaises(PermissionError):
+            self.brain.restore_active('r1')
+        self.brain.restore_active('r1', approved=True)
+        self.assertEqual(len(self.brain.search('dashboard')), 1)
+
+    def test_retention_rechecks_remote_corruption(self):
+        self.add(age=31)
+        self.brain.sync()
+        self.recovery()
+        self.vault.objects['r1'] = b'tampered after initial verification'
+        self.assertEqual(self.brain.expire_active(approved=True)['preserved'], 1)
+        self.assertEqual(self.brain.health()['active'], 1)
+
+    def test_wrong_key_rejects_content(self):
+        self.add()
+        other = SecondBrain(self.path, os.urandom(32), self.vault)
+        try:
+            with self.assertRaises(Exception):
+                other.retrieve('r1')
+        finally:
+            other.close()
+
+    def test_old_approval_is_never_authority(self):
