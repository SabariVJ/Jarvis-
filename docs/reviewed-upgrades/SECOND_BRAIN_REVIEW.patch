+"""Opt-in encrypted memory. No automatic capture, network client or tool authority.
+
+All external vault implementations and production capture wiring require review.
+Search decrypts locally: no plaintext database, FTS index or cloud embeddings.
+"""
+from __future__ import annotations
+
+import base64
+import hashlib
+import json
+import os
+import re
+import sqlite3
+import threading
+import time
+from typing import Protocol
+
+from cryptography.hazmat.primitives.ciphers.aead import AESGCM
+from cryptography.hazmat.primitives.kdf.scrypt import Scrypt
+
+MAX_RECORD = 256 * 1024
+MAX_ARCHIVE = MAX_RECORD + 4096
+DAY = 86400
+
+
+class Vault(Protocol):
+    """Authenticated adapters must bound GETs and implement atomic put-if-absent.
+
+    No provider is provisioned by this protocol. Object identifiers are opaque;
+    encrypted payloads must never be replaced under an existing identifier.
+    """
+    def put_if_absent(self, object_id: str, payload: bytes) -> None: ...
+    def get(self, object_id: str) -> bytes: ...
+    def delete(self, object_id: str) -> None: ...
+    def usage(self) -> dict: ...
+
+
+class SyntheticVault:
+    """In-memory TEST adapter only; not durable storage or a cloud service."""
+    def __init__(self, quota=4 * 1024 * 1024):
+        self.objects = {}
+        self.quota = quota
+        self.online = True
+
+    def _check(self):
+        if not self.online:
+            raise ConnectionError('synthetic vault offline')
+
+    def put_if_absent(self, object_id, payload):
+        self._check()
+        if object_id in self.objects:
+            if self.objects[object_id] != payload:
+                raise ValueError('immutable archive conflict')
+            return
+        if len(payload) > MAX_ARCHIVE or sum(map(len, self.objects.values())) + len(payload) > self.quota:
+            raise OverflowError('archive quota')
+        self.objects[object_id] = bytes(payload)
+
+    def get(self, object_id):
+        self._check()
+        return self.objects[object_id]
+
+    def delete(self, object_id):
+        self._check()
+        self.objects.pop(object_id, None)
+
+    def usage(self):
+        return {'provider': 'synthetic_memory_only', 'bytes': sum(map(len, self.objects.values())), 'quota': self.quota}
+
+
+def redact(text):
+    text = re.sub(r'(?i)\b(?:Bearer\s+)[^\s]+', '[REDACTED]', text)
+    text = re.sub(r'(?i)\b(api[_ -]?key|password|token|secret)\s*[:=]\s*(?:"[^"]*"|\x27[^\x27]*\x27|[^\s,;]+)', r'\1=[REDACTED]', text)
+    text = re.sub(r'\b(?:sk-[A-Za-z0-9_-]{12,}|gh[pousr]_[A-Za-z0-9_]{12,})\b', '[REDACTED]', text)
+    return text
+
+
+def _encoded(value):
+    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=False).encode('utf-8')
+
+
+def recovery_export(key: bytes, passphrase: str) -> bytes:
+    """Return passphrase-encrypted key. Caller chooses secure offline storage.
+
+    This does not save a key, print it, or prove recovery until separately tested.
+    """
+    if len(key) != 32 or len(passphrase) < 16:
+        raise ValueError('32-byte key and >=16-character recovery passphrase required')
+    salt, nonce = os.urandom(16), os.urandom(12)
+    derived = Scrypt(salt=salt, length=32, n=2**15, r=8, p=1).derive(passphrase.encode())
+    return b'JSBR1' + salt + nonce + AESGCM(derived).encrypt(nonce, key, b'jarvis-recovery-v1')
+
+
+def recovery_import(envelope: bytes, passphrase: str) -> bytes:
+    if len(envelope) != 81 or envelope[:5] != b'JSBR1':
+        raise ValueError('invalid recovery envelope')
+    salt, nonce = envelope[5:21], envelope[21:33]
+    derived = Scrypt(salt=salt, length=32, n=2**15, r=8, p=1).derive(passphrase.encode())
+    return AESGCM(derived).decrypt(nonce, envelope[33:], b'jarvis-recovery-v1')
+
+
+class SecondBrain:
+    """Explicit calls only. Returned memories are DATA, never authorization.
+
+    Key is injected by a future reviewed key store; it is never stored in SQLite.
+    Capture defaults OFF every process start. No live JARVIS integration yet.
+    SQLite timestamps/identifiers/health metadata are intentionally not encrypted.
+    """
+    def __init__(self, database, key: bytes, vault: Vault, clock=time.time):
+        if len(key) != 32:
+            raise ValueError('AES-256 key required')
+        self._key = bytes(key)
+        self._cipher = AESGCM(key)
+        self.vault, self.clock = vault, clock
+        self.capture_enabled = False
+        self.recovery_verified = False
+        self._lock = threading.RLock()
+        self.db = sqlite3.connect(database, check_same_thread=False)
+        self.db.row_factory = sqlite3.Row
+        self.db.executescript('''
+          CREATE TABLE IF NOT EXISTS brain_records(
+            id TEXT PRIMARY KEY, created REAL NOT NULL, payload BLOB,
+            digest TEXT NOT NULL, state TEXT NOT NULL DEFAULT 'pending',
+            verified REAL, attempts INTEGER NOT NULL DEFAULT 0,
+            error TEXT, delete_requested INTEGER NOT NULL DEFAULT 0);
+          CREATE INDEX IF NOT EXISTS brain_created ON brain_records(created);
+        ''')
+        self.db.commit()
+
+    def close(self):
+        self.db.close()
+
+    def set_capture_consent(self, enabled: bool):
+        if type(enabled) is not bool:
+            raise ValueError('explicit boolean consent required')
+        self.capture_enabled = enabled
+
+    def verify_recovery(self, envelope, passphrase):
+        recovered = recovery_import(envelope, passphrase)
+        import hmac
+        self.recovery_verified = hmac.compare_digest(recovered, self._key)
+        if not self.recovery_verified:
+            raise ValueError('recovery key does not match')
+
+    def capture(self, record_id, session, role, text, *, project='', kind='conversation', created=None):
+        if not self.capture_enabled:
+            raise PermissionError('conversation capture requires opt-in')
+        if not re.fullmatch(r'[A-Za-z0-9_-]{1,80}', record_id):
+            raise ValueError('invalid opaque record identity')
+        if role not in {'user', 'assistant'} or kind not in {'conversation', 'confirmed_decision', 'verified_receipt', 'summary'}:
+            raise ValueError('unsupported record provenance')
+        timestamp = float(self.clock() if created is None else created)
+        import math
+        if not math.isfinite(timestamp) or timestamp < 0 or timestamp > self.clock() + 60:
+            raise ValueError('invalid timestamp')
+        data = _encoded({'session': redact(str(session)), 'role': role, 'text': redact(str(text)),
+                         'project': redact(str(project)), 'kind': kind, 'created': timestamp})
+        if len(data) > MAX_RECORD:
+            raise ValueError('record too large')
+        with self._lock, self.db:
+            row = self.db.execute('SELECT * FROM brain_records WHERE id=?', (record_id,)).fetchone()
+            if row:
+                if row['payload'] is not None and not row['delete_requested'] and self._decode(record_id, row['payload']) == json.loads(data):
+                    return record_id
+                raise ValueError('record identity already used; immutable revision required')
+            nonce = os.urandom(12)
+            payload = b'JSB1' + nonce + self._cipher.encrypt(nonce, data, record_id.encode())
+            self.db.execute('INSERT INTO brain_records(id,created,payload,digest) VALUES(?,?,?,?)',
+                            (record_id, timestamp, payload, hashlib.sha256(payload).hexdigest()))
+        return record_id
+
+    def _decode(self, record_id, payload):
+        if len(payload) > MAX_ARCHIVE or payload[:4] != b'JSB1':
+            raise ValueError('invalid archive')
+        data = self._cipher.decrypt(payload[4:16], payload[16:], record_id.encode())
+        return json.loads(data)
+
+    def _fetch_verified(self, row):
+        payload = self.vault.get(row['id'])
+        if len(payload) > MAX_ARCHIVE or hashlib.sha256(payload).hexdigest() != row['digest']:
+            raise ValueError('archive integrity mismatch')
+        data = self._decode(row['id'], payload)
+        if data['created'] != row['created']:
+            raise ValueError('archive timestamp mismatch')
+        return payload
+
+    def sync(self, limit=20):
+        """One bounded attempt per pending record per explicit invocation.
+
+        PUT is immutable/idempotent. GET + authenticated decryption is mandatory.
+        Interrupted PUT remains pending for a later explicit sync; no background retry.
+        """
+        if not 1 <= limit <= 100:
+            raise ValueError('sync limit must be 1..100')
+        result = {'verified': 0, 'failed': 0}
+        with self._lock:
+            rows = self.db.execute("SELECT * FROM brain_records WHERE state='pending' AND delete_requested=0 ORDER BY created,id LIMIT ?", (limit,)).fetchall()
+            for row in rows:
+                try:
+                    self.vault.put_if_absent(row['id'], row['payload'])
+                    self._fetch_verified(row)
+                    with self.db:
+                        self.db.execute("UPDATE brain_records SET state='archived',verified=?,attempts=attempts+1,error=NULL WHERE id=?", (self.clock(), row['id']))
+                    result['verified'] += 1
+                except Exception as exc:
+                    # No provider exception strings: URLs, credentials and paths may leak.
+                    reason = 'quota' if isinstance(exc, OverflowError) else 'archive_unavailable_or_invalid'
+                    with self.db:
+                        self.db.execute('UPDATE brain_records SET attempts=attempts+1,error=? WHERE id=?', (reason, row['id']))
+                    result['failed'] += 1
+        return result
+
+    def expire_active(self, *, approved=False, days=30):
+        if approved is not True or not self.recovery_verified:
+            raise PermissionError('retention approval and tested key recovery required')
+        if days != 30:
+            raise ValueError('only reviewed rolling 30-day policy is implemented')
+        cutoff = self.clock() - days * DAY
+        result = {'expired': 0, 'preserved': 0}
+        with self._lock:
+            rows = self.db.execute('SELECT * FROM brain_records WHERE created<? AND payload IS NOT NULL AND delete_requested=0', (cutoff,)).fetchall()
+            for row in rows:
+                try:
+                    if row['state'] != 'archived':
+                        raise ValueError('not synchronized')
+                    self._fetch_verified(row)
+                    with self.db:
+                        self.db.execute('UPDATE brain_records SET payload=NULL WHERE id=?', (row['id'],))
+                    result['expired'] += 1
+                except Exception:
+                    result['preserved'] += 1
+        # Logical removal, NOT guaranteed secure erasure from SQLite/free disk pages.
+        return result
+
+    def retrieve(self, record_id):
+        with self._lock:
+            row = self.db.execute('SELECT * FROM brain_records WHERE id=? AND delete_requested=0', (record_id,)).fetchone()
+            if row is None:
+                raise KeyError('memory unavailable')
+            payload = row['payload'] if row['payload'] is not None else self._fetch_verified(row)
+            data = self._decode(record_id, payload)
+            return {'id': record_id, 'record': data, 'provenance': 'stored_record', 'trusted_for_execution': False}
+
+    def search(self, query, *, project=None, limit=20):
+        """Bounded local lexical search, NOT semantic/model-generated recall."""
+        if not query or len(query) > 256 or not 1 <= limit <= 100:
+            raise ValueError('bounded nonempty search required')
+        found = []
+        with self._lock:
+            rows = self.db.execute('SELECT id,payload FROM brain_records WHERE payload IS NOT NULL AND delete_requested=0 ORDER BY created DESC,id LIMIT 1000').fetchall()
+            for row in rows:
+                data = self._decode(row['id'], row['payload'])
+                if query.casefold() in data['text'].casefold() and (project is None or data['project'] == project):
+                    found.append({'id': row['id'], 'record': data, 'trusted_for_execution': False})
+                    if len(found) == limit:
+                        break
+        return found
+
+    def export_encrypted(self, record_id):
+        with self._lock:
+            row = self.db.execute('SELECT * FROM brain_records WHERE id=? AND delete_requested=0', (record_id,)).fetchone()
+            if row is None:
+                raise KeyError(record_id)
+            payload = row['payload'] if row['payload'] is not None else self._fetch_verified(row)
+            self._decode(record_id, payload)
+            return _encoded({'version': 1, 'id': record_id, 'sha256': row['digest'], 'ciphertext': base64.b64encode(payload).decode()})
+
+    def restore_active(self, record_id, *, approved=False):
+        """Explicit archive-to-local restoration; never invokes the model or tools."""
+        if approved is not True:
+            raise PermissionError('explicit restore approval required')
+        with self._lock:
+            row = self.db.execute('SELECT * FROM brain_records WHERE id=? AND delete_requested=0', (record_id,)).fetchone()
+            if row is None:
+                raise KeyError(record_id)
+            if row['payload'] is None:
+                payload = self._fetch_verified(row)
+                with self.db:
+                    self.db.execute('UPDATE brain_records SET payload=? WHERE id=?', (payload, record_id))
+            return self.retrieve(record_id)
+
+    def delete(self, record_id, *, confirmation):
+        """Caller must obtain fresh owner approval; tombstone survives partial failure.
+
+        No dashboard button or history-derived command invokes this automatically.
+        """
+        if confirmation != 'DELETE ' + record_id:
+            raise PermissionError('exact record deletion confirmation required')
+        with self._lock:
+            row = self.db.execute('SELECT * FROM brain_records WHERE id=?', (record_id,)).fetchone()
+            if row is None:
+                raise KeyError(record_id)
+            with self.db:
+                self.db.execute('UPDATE brain_records SET delete_requested=1 WHERE id=?', (record_id,))
+            self.vault.delete(record_id)
+            try:
+                self.vault.get(record_id)
+            except KeyError:
+                pass
+            else:
+                raise ValueError('remote deletion not verified')
+            with self.db:
+                self.db.execute("UPDATE brain_records SET payload=NULL,state='deleted',error=NULL WHERE id=?", (record_id,))
+
+    def health(self):
+        with self._lock:
+            rows = self.db.execute('SELECT state,COUNT(*) n FROM brain_records GROUP BY state').fetchall()
+            active = self.db.execute('SELECT COUNT(*) FROM brain_records WHERE payload IS NOT NULL AND delete_requested=0').fetchone()[0]
+        return {'capture_enabled': self.capture_enabled, 'recovery_verified': self.recovery_verified,
+                'active': active, 'states': {r['state']: r['n'] for r in rows},
+                'cloud_live_verified': False, 'execution_authority': False,
+                'search': 'local_lexical_latest_1000', 'retention': 'explicit_rolling_30_days'}
