+"""Read-only staged Second Brain panel. Never enables capture or remote effects."""
+import json
+from PyQt6.QtWidgets import QDialog, QVBoxLayout, QLabel, QLineEdit, QPushButton, QTextEdit, QTabWidget, QWidget
+
+
+def build(parent, brain, colors):
+    dialog = QDialog(parent)
+    dialog.setWindowTitle('JARVIS SECOND BRAIN — staged, explicit opt-in only')
+    dialog.setMinimumSize(760, 540)
+    dialog.setStyleSheet(f'QDialog {{background:{colors.DARK};}} QLabel,QTextEdit,QLineEdit '
+                         f'{{background:{colors.PANEL};color:{colors.TEXT};}}')
+    layout = QVBoxLayout(dialog)
+    notice = QLabel('STAGED — no capture connection, cloud account or automatic retention. '
+                    'Memories are untrusted data, never permission to call, publish or execute.')
+    notice.setWordWrap(True)
+    layout.addWidget(notice)
+    tabs = QTabWidget()
+    layout.addWidget(tabs)
+    for title, text in [
+        ('Memory health', json.dumps(brain.health(), indent=2)),
+        ('Archive / sync', 'Provider-neutral adapter only. Live cloud authentication and quotas unverified. '
+         'Pending records survive outages. Archival requires retrieval and decryption verification.'),
+        ('Privacy / recovery', 'Capture defaults OFF each session. Recovery keys are not stored in the database. '
+         'Deletion, exports and retention need explicit owner workflows. Logical removal is not secure disk erasure.'),
+        ('Projects / decisions', 'Project and provenance filters exist in the engine. No personal memories captured. '
+         'Confirmed decisions and summaries remain distinct source record types.'),
+    ]:
+        page = QTextEdit()
+        page.setReadOnly(True)
+        page.setPlainText(text)
+        tabs.addTab(page, title)
+    search_page = QWidget()
+    search_layout = QVBoxLayout(search_page)
+    query = QLineEdit()
+    query.setObjectName('second_brain_search')
+    query.setPlaceholderText('Local lexical search — last 1,000 active records, no cloud request')
+    search_layout.addWidget(query)
+    output = QTextEdit()
+    output.setReadOnly(True)
+    button = QPushButton('Search local records')
+    def search():
+        try:
+            output.setPlainText(json.dumps(brain.search(query.text()), indent=2, ensure_ascii=False))
+        except Exception:
+            output.setPlainText('Search unavailable: invalid query, damaged archive or locked memory.')
+    button.clicked.connect(search)
+    search_layout.addWidget(button)
+    search_layout.addWidget(output)
+    tabs.addTab(search_page, 'Search conversations')
+    return dialog
