+        class Colors:
+            DARK = '#111111'
+            PANEL = '#222222'
+            TEXT = '#eeeeee'
+            PRI = '#00ccff'
+            BORDER = '#333333'
+        from core.guardian_panel import build
+        with patch('core.github_guardian.GhClient', side_effect=AssertionError('UI must not call GitHub')):
+            self.panel = build(None, self.runtime, self.submit, Colors)
