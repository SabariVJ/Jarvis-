+"""Local VibeCoding Studio; never generate or execute on opening the panel."""
+import json
+from PyQt6.QtCore import QTimer
+from PyQt6.QtWidgets import QDialog,QVBoxLayout,QHBoxLayout,QLabel,QTextEdit,QLineEdit,QPushButton
+
+def build(parent,rt,submit,colors):
+    from core import vibe_provider
+    dialog = QDialog(parent)
+    dialog.setWindowTitle('VIBECODING STUDIO — supervised proposals')
+    dialog.setMinimumSize(800,600)
+    dialog.setStyleSheet(f'QDialog{{background:{colors.DARK};}} QLabel,QTextEdit,QLineEdit'
+                        f'{{background:{colors.PANEL};color:{colors.TEXT};}} QPushButton'
+                        f'{{background:{colors.PANEL};color:{colors.PRI};padding:6px;border:1px solid {colors.BORDER};}}')
+    layout = QVBoxLayout(dialog)
+    title = QLabel('VIBECODING STUDIO')
+    title.setStyleSheet(f'color:{colors.PRI};font:bold 16px "Courier New";')
+    layout.addWidget(title)
+    summary = QLabel()
+    summary.setWordWrap(True)
+    layout.addWidget(summary)
+    display = QTextEdit(); display.setReadOnly(True); display.setObjectName('vibe_status')
+    layout.addWidget(display)
+    goal = QLineEdit(); goal.setPlaceholderText('Describe your feature; planning is not approval to run inference')
+    layout.addWidget(goal)
+    identity = QLineEdit(); identity.setPlaceholderText('Actual task ID for review/cancel/test/undo')
+    layout.addWidget(identity)
+    buttons = QHBoxLayout(); layout.addLayout(buttons)
+    def send(text):
+        submit(text); dialog.accept()
+    def task_command(verb):
+        import re
+        value = identity.text().strip()
+        if not re.fullmatch('[a-f0-9]{12}',value):
+            summary.setText('Select a real task ID; placeholder IDs are not authorization')
+            return
+        send(verb + ' vibe task ' + value)
+    for label,callback in [('Prepare plan',lambda:send('vibe code ' + goal.text().strip())),
+                           ('Review',lambda:task_command('review')),('Cancel',lambda:task_command('cancel')),
+                           ('Undo last',lambda:task_command('undo')),('Test readiness',lambda:task_command('test'))]:
+        button = QPushButton(label); button.clicked.connect(callback); buttons.addWidget(button)
+    foot = QLabel('Generated proposals remain task-local and untested until a restricted runtime is verified. '
+                  'No original-checkout apply, commit, push, PR, deployment or Codex execution from this panel.')
+    foot.setWordWrap(True); layout.addWidget(foot)
+    def refresh():
+        selected = rt.get('vibe','selection',{})
+        provider = vibe_provider.status(rt)
+        jobs = [job for job in rt.records('job').values() if job.get('kind')=='vibe'][-10:]
+        summary.setText('Development repository: ' + selected.get('repository','not selected') +
+                        '\nProvider: ' + ('configured candidate; verification required' if provider.get('configured') else 'awaiting_provider') +
+                        ' | Test execution: BLOCKED without a verified non-Codex runtime')
+        alerts = [row for row in rt.records('notification').values() if row.get('task_id') in {job['id'] for job in jobs}][-20:]
+        display.setPlainText(json.dumps({'selection':selected,'provider':provider,'tasks':jobs,'notification_history':alerts,
+            'publication':'unapproved; no mutations'},indent=2,ensure_ascii=False))
+    refresh()
+    timer = QTimer(dialog); timer.setInterval(5000); timer.timeout.connect(refresh); timer.start()
+    return dialog
