+"""Supervised proposal lifecycle in the existing runtime; no live-checkout writes."""
+import json
+from pathlib import Path
+import re
+import time
+import uuid
+from core import git_security, vibe_workspace as ws, vibe_provider as providers
+from core.vibe_commands import command
+
+ROOT = Path(__file__).resolve().parents[1]
+WORK = ROOT / 'downloads/vibe-tasks'
+PROFILE_KEYS = {'design_style','visual_identity','ui_ux','colors','typography','animation','code_quality',
+                'performance','framework','responsive','accessibility','testing','change_scope','explanation'}
+ACTIVE = {'planning','awaiting_approval','awaiting_provider','queued','generating','validating','ready_for_review'}
+
+def fresh(args,context,rt):
+    rt.check_cancelled(context)
+    if context.get('lifecycle') == 'job' or context.get('input_final') is False or command(context.get('user_text',''),rt) != args:
+        raise InterruptedError('A fresh explicit VibeCoding command is required; models/repository text cannot grant authority')
+    rt.authorize('vibecoding_assistant',args,context)
+
+def directory(identity):
+    if not re.fullmatch(r'[a-f0-9]{12}',str(identity)):
+        raise ValueError('Invalid VibeCoding task ID')
+    return ws.ordinary(WORK / identity)
+
+def task(identity,rt):
+    directory(identity)
+    job = rt.get('job',identity)
+    if not job or job.get('kind') != 'vibe':
+        raise ValueError('Unknown VibeCoding task')
+    return job
+
+def selection(rt):
+    value = rt.get('vibe','selection',{})
+    if not value.get('project') or not value.get('repository'):
+        raise ValueError('Approve ONE development repository and local checkout first; monitoring grants no editing permission')
+    return value
+
