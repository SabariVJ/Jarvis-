+"""Shared fresh-intent grammar; no authority from repository/model text."""
+import re
+
+def command(text, rt=None):
+    value = re.sub(r'^(?:(?:hey )?jarvis[, ]+)?(?:please )?', '', str(text).strip(), flags=re.I)
+    simple = {'show vibecoding studio': 'status', 'show coding providers': 'providers',
+              'show vibe preferences': 'profile', 'reset vibe preferences': 'reset_profile',
+              'enable local coding for this project': 'enable_provider'}
+    if value.casefold().rstrip('.!?') in simple:
+        return {'action': simple[value.casefold().rstrip('.!?')]}
+    match = re.fullmatch(r'approve development github ([\w.-]+/[\w.-]+) at (.+)', value, re.I)
+    if match:
+        return {'action': 'select', 'repository': match[1].casefold(), 'project': match[2].strip().strip('"')}
+    match = re.fullmatch(r'(generate|show|review|cancel|undo|test|prepare publication for) vibe task ([a-f0-9]{12})[.!]?', value, re.I)
+    if match:
+        return {'action': {'generate':'generate','show':'task','review':'review','cancel':'cancel',
+                           'undo':'undo','test':'test','prepare publication for':'publication'}[match[1].casefold()], 'id':match[2].lower()}
+    match = re.fullmatch(r'revise vibe task ([a-f0-9]{12}):\s*(.{1,2000})', value, re.I)
+    if match:
+        return {'action':'revise','id':match[1].lower(),'goal':match[2].strip()}
+    match = re.fullmatch(r'set vibe preference ([a-z_]+):\s*(.{1,500})', value, re.I)
+    if match:
+        return {'action':'set_profile','key':match[1].lower(),'value':match[2].strip()}
+    match = re.fullmatch(r'(?:vibe code|prepare coding task:)\s*(.{1,2000})', value, re.I)
+    if match:
+        return {'action':'prepare','goal':match[1].strip()}
+    if re.fullmatch(r'(?:make (?:this|my|the) (?:dashboard|website|application) .+|fix the login bug|add a modern settings page|improve (?:my|the) application(?:\x27s)? animations|make the website responsive on mobile)', value, re.I):
+        return {'action':'prepare','goal':value}
+    if rt and getattr(rt, '_vibe_focus', None):
+        if value.casefold().rstrip('.!?') == 'undo only the last change':
+            return {'action':'undo','id':rt._vibe_focus}
+        if value.casefold().rstrip('.!?') in {'make it darker','keep the old animation'}:
+            return {'action':'revise','id':rt._vibe_focus,'goal':value}
+    return None
