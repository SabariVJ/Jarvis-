+"""Source-only task worktrees and structured edits. Never execute repository code."""
+from collections import Counter
+import difflib
+import hashlib
+import json
+import os
+from pathlib import Path
+import re
+import stat
+
+from core import git_security
+from core.process_runner import run_process
+
+EXTENSIONS = {'.py','.js','.jsx','.ts','.tsx','.css','.scss','.html','.vue','.svelte','.go','.rs','.java','.cs','.cpp','.c','.h','.md','.json','.toml','.txt'}
+PROTECTED = {'package.json','package-lock.json','requirements.txt','pyproject.toml','setup.py','poetry.lock','uv.lock',
+             'pnpm-lock.yaml','yarn.lock','.gitignore','Dockerfile'}
+SECURITY = ('core/codex','core/mxc','core/git_security','core/git_workflow','core/automation_runtime',
+            'plugins/whatsapp_control','core/calling','core/vibe_')
+
+def sha(data):
+    return hashlib.sha256(data).hexdigest() if data is not None else None
+
+def ordinary(path):
+    path = Path(path).absolute()
+    for component in (path, *path.parents):
+        if component.is_symlink() or (component.exists() and getattr(component.lstat(),'st_file_attributes',0) & 0x400):
+            raise ValueError('Symlinks/junctions/reparse points are excluded')
+    return path.resolve()
+
+def name_allowed(name, writing=False):
+    if not isinstance(name,str) or '\\' in name or name != git_security.allowed_path(name).as_posix():
+        raise ValueError('Use canonical forward-slash source paths')
+    path = Path(name)
+    if path.suffix.lower() not in EXTENSIONS:
+        raise ValueError('Unsupported source type')
+    if writing and (path.name in PROTECTED or name.startswith(SECURITY) or name.startswith(('.github/','config/','memory/')) or
+                    path.suffix in {'.toml','.json','.txt'}):
+        raise ValueError('Dependency, configuration, security or runtime changes need separate manual review')
+    return name
+
+def git(root, args, context, timeout=40):
+    root = ordinary(root)
+    env = {k:v for k,v in os.environ.items() if not k.upper().startswith(('GIT_','SSH_'))}
+    env.update(GIT_CONFIG_NOSYSTEM='1',GIT_CONFIG_GLOBAL=os.devnull,GIT_TERMINAL_PROMPT='0',GIT_LITERAL_PATHSPECS='1')
+    done = run_process(['git','-c','core.hooksPath=' + str(root / '.vibe-no-hooks'),'-c','core.fsmonitor=false',
+        '-c','core.attributesFile=' + os.devnull,'-C',str(root),*args], context=context,cwd=root,env=env,
+        timeout=timeout,max_output_bytes=4*1024*1024,allow_truncated=False)
+    if done.returncode:
+        raise ValueError('Bounded Git workspace operation failed; no reset/checkout fallback. ' + git_security.redact(done.stdout))
+    return done.stdout
+
+def inspect_project(root, goal, context):
+    root = ordinary(root)
+    if ordinary(git(root,['rev-parse','--show-toplevel'],context).strip()) != root:
+        raise ValueError('Approve the exact local Git checkout root')
+    names = git(root,['ls-files','--cached','--others','--exclude-standard','-z'],context).split('\0')
+    names = sorted(set(name for name in names if name))
+    if len(names) > 8000:
+        raise ValueError('Repository inventory exceeds the 8,000-name bound; select a smaller project')
+    candidates, excluded, total = {}, 0, 0
+    for name in names:
+        try:
+            name_allowed(name)
+            data = git_security.file_bytes(root,name)
+            if data is None:
+                continue
+            if len(data) > 200000 or total + len(data) > 5*1024*1024 or len(candidates) >= 200:
+                excluded += 1
+                continue
+            candidates[name] = data
+            total += len(data)
+        except (ValueError, SyntaxError):
+            excluded += 1
+    if not candidates:
+        raise ValueError('No safe bounded UTF-8 source files were found')
+    dependencies, scripts, frameworks = {}, {}, []
+    package = candidates.get('package.json')
+    if package:
+        try:
+            manifest = json.loads(package)
+            dependencies = {**manifest.get('dependencies',{}),**manifest.get('devDependencies',{})}
+            scripts = {str(k):str(v)[:400] for k,v in manifest.get('scripts',{}).items()}
+        except (ValueError,TypeError,AttributeError):
+            pass
+    for dependency, framework in [('next','Next.js'),('react','React'),('vue','Vue'),('svelte','Svelte'),('@angular/core','Angular')]:
+        if dependency in dependencies:
+            frameworks.append(framework)
+    requirements = candidates.get('requirements.txt',b'').decode('utf-8','replace').casefold()
+    for dependency in ('django','flask','fastapi','pyside6','pyqt6'):
+        if dependency in requirements:
+            frameworks.append(dependency)
+    words = set(re.findall(r'[a-z]{3,}',goal.casefold()))
+    def rank(name):
+        value = name.casefold()
+        score = sum(4 for word in words if word in value)
+        score += 2 if any(part in value for part in ('src/','app/','components/','pages/','ui.','test')) else 0
+        return (-score,len(name),name)
+    explicit = [name for name in candidates if re.search(r'(?<![\w./-])' + re.escape(name) + r'(?![\w./-])',goal,re.I)]
+    writable = []
+    for name in sorted(explicit or candidates,key=rank):
+        try:
+            name_allowed(name,writing=True)
+            writable.append(name)
+        except ValueError:
+            pass
+        if len(writable) >= 12:
+            break
+    context_names = list(dict.fromkeys([n for n in ('package.json','requirements.txt','pyproject.toml','readme.md','README.md') if n in candidates] + writable))
+    language = Counter(Path(name).suffix.lower() for name in candidates)
+    return {'files':candidates,'context':context_names,'writable':writable,'excluded':excluded,
+            'allow_additions':not bool(explicit),
+            'languages':dict(language),'frameworks':frameworks,'dependencies':sorted(dependencies)[:100],
+            'documented_commands_untrusted_not_approved':scripts,'source_bytes':total}
+
+def create(root, directory, goal, identity, context):
+    directory = ordinary(directory)
+    source = directory / 'workspace'
+    if source.exists():
+        raise ValueError('Workspace already exists; never overwrite it')
+    info = inspect_project(root,goal,context)
+    directory.mkdir(parents=True,exist_ok=False)
+    head = git(root,['rev-parse','--verify','HEAD'],context).strip()
+    if not re.fullmatch(r'[a-f0-9]{40,64}',head):
+        raise ValueError('No stable local base commit exists')
+    branch = 'jarvis/vibe-' + identity
+    git(root,['worktree','add','--no-checkout','-b',branch,str(source),head],context)
+    originals = directory / 'originals'
+    originals.mkdir()
+    manifest = {}
+    for name,data in info.pop('files').items():
+        # Detect edits during the snapshot, including dirty/untracked source.
+        if git_security.file_bytes(Path(root),name) != data:
+            raise ValueError('Source changed during preparation; no original file overwritten')
+        for base in (source,originals):
+            target = base / name
+            target.parent.mkdir(parents=True,exist_ok=True)
+            target.write_bytes(data)
+        manifest[name] = sha(data)
+    result = {**info,'manifest':manifest,'branch':branch,'base_commit':head,
+              'write_roots':sorted(set(str(Path(name).parent).replace('\\','/') for name in info['writable'])) if info['allow_additions'] else [],
+              'workspace':str(source),'filesystem_isolation':'source-only worktree; NOT an OS execution sandbox'}
+    (directory / 'manifest.json').write_text(json.dumps(result,indent=2),encoding='utf-8')
+    return result
+
+def proposal(job, directory, data):
+    if not isinstance(data,dict) or data.get('schema') != 1 or set(data) - {'schema','summary','changes'}:
+        raise ValueError('Provider must return structured patch schema 1')
+    changes = data.get('changes')
+    if not isinstance(changes,list) or not 1 <= len(changes) <= 12:
+        raise ValueError('A proposal must contain 1–12 exact file changes')
+    root = ordinary(directory / 'workspace')
+    names, clean, diff, total = set(), [], [], 0
+    for change in changes:
+        if not isinstance(change,dict) or set(change) != {'path','before_sha256','operation','content'}:
+            raise ValueError('Malformed structured file change')
+        name = name_allowed(change['path'],writing=True)
+        if name.casefold() in names:
+            raise ValueError('Duplicate or case-ambiguous patch path')
+        names.add(name.casefold())
+        before = git_security.file_bytes(root,name)
+        expected = job['manifest'].get(name)
+        if sha(before) != expected or change['before_sha256'] != expected:
+            raise ValueError('Patch base mismatch or concurrent workspace edit: ' + name)
+        if name not in job['writable']:
+            parent = Path(name).parent.as_posix()
+            if before is not None or parent not in job['write_roots']:
+                raise ValueError('File outside approved edit/addition scope: ' + name)
+        operation = change['operation']
+        if operation not in {'write','delete'} or (operation == 'delete' and (before is None or change['content'] is not None)):
+            raise ValueError('Invalid add/edit/delete operation')
+        after = None if operation == 'delete' else change['content'].encode('utf-8') if isinstance(change['content'],str) else None
+        if operation == 'write' and after is None:
+            raise ValueError('Write requires complete UTF-8 file content')
+        if after is not None:
+            git_security.inspect_bytes(name,after)
+        total += len(after or b'')
+        if total > 500000:
+            raise ValueError('Generated changes exceed 500,000 bytes')
+        if before == after:
+            raise ValueError('Patch contains a no-op instead of an actual change')
+        clean.append({'path':name,'before_sha256':expected,'operation':operation,'content':change['content'], 'after_sha256':sha(after)})
+        diff.extend(difflib.unified_diff((before or b'').decode('utf-8-sig').splitlines(True),
+            (after or b'').decode('utf-8-sig').splitlines(True),fromfile='a/'+name if before is not None else '/dev/null',
+            tofile='b/'+name if after is not None else '/dev/null'))
+    digest = sha(json.dumps(clean,sort_keys=True).encode())
+    return {'changes':clean,'review':digest,'diff':''.join(diff),'syntax':'Python syntax compiled, not imported; other languages untested',
+            'tests':{'state':'untested','reason':'No independently verified non-Codex restricted test runtime configured'}}
+
+def apply(job, directory, checked, rt, context):
+    root = ordinary(directory / 'workspace')
+    # Receipt is consumed before the first write. Partial writes never replay.
+    with rt.side_effect('vibe_apply_task_local',context):
+        rt.update('job',job['id'],{'apply_started':True},expected={'state':'validating','apply_started':False})
+        backup = directory / ('rollback-' + str(job['revision']))
+        backup.mkdir(exist_ok=False)
+        receipts = []
+        for change in checked['changes']:
+            rt.check_cancelled(context)
+            name = change['path']
+            current = git_security.file_bytes(root,name)
+            if sha(current) != change['before_sha256']:
+                raise ValueError('Concurrent workspace change before write')
+            if current is not None:
+                saved = backup / name
+                saved.parent.mkdir(parents=True,exist_ok=True)
+                saved.write_bytes(current)
+            target = root / name
+            target.parent.mkdir(parents=True,exist_ok=True)
+            ordinary(target.parent)
+            if change['operation'] == 'delete':
+                # Exact approved copied file only; original checkout is untouched.
+                target.unlink()
+            else:
+                import tempfile
+                with tempfile.NamedTemporaryFile(dir=target.parent,prefix='.vibe-',delete=False) as handle:
+                    handle.write(change['content'].encode('utf-8'))
+                    handle.flush(); os.fsync(handle.fileno())
+                    temporary = Path(handle.name)
+                try:
+                    os.replace(temporary,target)
+                finally:
+                    if temporary.exists():
+                        temporary.unlink()
+            receipts.append({'path':name,'before_sha256':change['before_sha256'],'after_sha256':change['after_sha256'],'state':'written_task_local'})
+            rt.update('job',job['id'],{'apply_receipts':receipts},expected={'execution_id':context['execution_id']})
